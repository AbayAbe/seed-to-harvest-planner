HOST=127.0.0.1
PORT=4000
DATABASE_PATH=data/juragan.sqlite
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
# OTP saat ini hanya simulasi lokal, tidak mengirim pesan WhatsApp/SMS.
# NODE_ENV=production diblokir sampai tersedia penyedia OTP nyata.
# ALLOW_DEMO_AUTH=true hanya untuk demo terkontrol melalui HTTPS.
# Gunakan HOST=0.0.0.0 jika layanan perlu diakses dari container/server lain.

# Klinik Tanaman: hanya backend, jangan pernah diberi awalan NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
# Untuk Pages: tambahkan https://abayabe.github.io ke FRONTEND_ORIGINS.
