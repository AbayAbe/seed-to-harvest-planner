{
  "name": "@agri/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "dev:clinic": "node --env-file-if-exists=.env --import tsx --watch src/clinic/server.ts",
    "start:clinic": "node --env-file-if-exists=.env dist/clinic/server.js"
  },
  "dependencies": {
    "@agri/contracts": "0.1.0",
    "date-fns": "^4.1.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "multer": "^2.5.0",
    "openai": "^7.57.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0"
  }
}
